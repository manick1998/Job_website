# ---------------------------------------------------------------
# SetuJobs environment configuration
# Copy to .env and fill in. NEVER commit real secrets.
# ---------------------------------------------------------------

# PostgreSQL (Drizzle ORM)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Public base URL used in email links, sitemap and canonical tags
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local file storage for resumes (S3-compatible adapter is the production target)
# UPLOAD_DIR=/var/lib/setujobs/uploads

# ---- Optional integrations (leave empty to use development fallbacks) ----

# Transactional email (SMTP). Without these, emails are stored in the email outbox (Admin > System).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM="SetuJobs <no-reply@setujobs.in>"

# S3-compatible object storage (AWS S3, Cloudflare R2, MinIO)
# S3_ENDPOINT=
# S3_REGION=ap-south-1
# S3_BUCKET=setujobs-resumes
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Razorpay (recruiter subscriptions). Server-side verification only.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Google OAuth (pending integration)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Redis (rate limiting & caching; in-memory fallback when unset)
# REDIS_URL=redis://127.0.0.1:6379

# AI features (resume analysis, JD generation). Optional.
# OPENAI_API_KEY=
